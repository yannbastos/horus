<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Horus.ViewModels"
        x:Class="Horus.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding AppName}"
        Width="960"
        Height="600"
        MinWidth="480"
        MinHeight="320"
        WindowStartupLocation="CenterScreen">
  <Border HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Padding="56,40"
          BorderBrush="{DynamicResource HorusLineBrush}"
          BorderThickness="1">
    <StackPanel Spacing="16">
      <TextBlock x:Name="AppNameText"
                 Classes="display"
                 Text="{Binding AppName}"
                 HorizontalAlignment="Center"
                 FontSize="56"
                 LetterSpacing="4" />
      <Border Classes="tag" HorizontalAlignment="Center">
        <TextBlock x:Name="StatusMessageText"
                   Classes="label"
                   Text="{Binding StatusMessage}" />
      </Border>
    </StackPanel>
  </Border>
</Window>
