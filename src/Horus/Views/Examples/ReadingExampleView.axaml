<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Horus.Views.Examples.ReadingExampleView">
  <ScrollViewer>
    <StackPanel MaxWidth="680"
                Margin="20,40"
                Spacing="20">
      <TextBlock Classes="label" Text="03 / LEITURA DE EXEMPLO" />
      <TextBlock Classes="display"
                 FontSize="30"
                 TextWrapping="Wrap"
                 Text="Título de um conteúdo de exemplo" />
      <TextBlock Classes="muted" Text="Texto fictício · 4 min de leitura" />
      <Border Height="1" Background="{DynamicResource HorusLineBrush}" />
      <TextBlock FontSize="16"
                 LineHeight="27"
                 TextWrapping="Wrap"
                 Text="Este parágrafo serve apenas para avaliar a leitura de textos longos no HORUS. Observe se o tamanho da fonte, o espaço entre as linhas e a largura da coluna continuam confortáveis depois de alguns minutos, tanto no tema claro quanto no escuro." />
      <TextBlock FontSize="16"
                 LineHeight="27"
                 TextWrapping="Wrap"
                 Text="Um segundo parágrafo ajuda a perceber o ritmo do texto. Palavras com acentuação, como revisão, memória e compreensão, também mostram como a fonte se comporta em português brasileiro." />
      <Border Padding="16"
              Background="{DynamicResource HorusSunkenBrush}"
              BorderBrush="{DynamicResource HorusLineBrush}"
              BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock Classes="label" Foreground="{DynamicResource HorusAccentInkBrush}" Text="DESTAQUE DE EXEMPLO" />
          <TextBlock TextWrapping="Wrap"
                     Text="Um bloco como este poderia destacar uma ideia importante no meio do conteúdo." />
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="primary" Content="AÇÃO PRINCIPAL" />
        <Button Content="AÇÃO SECUNDÁRIA" />
        <Button Content="DESATIVADO" IsEnabled="False" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
