<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Horus.ViewModels"
             x:Class="Horus.Views.Examples.HomeExampleView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer>
    <StackPanel Margin="28" Spacing="24">
      <Border BorderBrush="{DynamicResource HorusLineBrush}" BorderThickness="1"
              Background="{DynamicResource HorusSunkenBrush}" ClipToBounds="True">
        <Grid ColumnDefinitions="*,220" MinHeight="220">
          <StackPanel Margin="28" Spacing="14" VerticalAlignment="Center">
            <TextBlock Classes="label" Foreground="{DynamicResource HorusAccentInkBrush}" Text="HORUS / ESPAÇO DE ESTUDO" />
            <TextBlock Classes="display" FontSize="32" Text="Dê espaço&#10;ao conhecimento." TextWrapping="Wrap" />
            <TextBlock Classes="muted" MaxWidth="440" HorizontalAlignment="Left" TextWrapping="Wrap"
                       Text="Um lugar para suas ideias encontrarem novas conexões." />
          </StackPanel>
          <Viewbox Grid.Column="1" Margin="8,20,24,20" IsHitTestVisible="False">
            <Panel Width="220" Height="220">
              <Ellipse Width="184" Height="184" Stroke="{DynamicResource HorusLineStrongBrush}" StrokeThickness="1" />
              <Ellipse Width="140" Height="140" Stroke="{DynamicResource HorusLineBrush}" StrokeThickness="1" />
              <Panel Classes="orbit" Width="220" Height="220" RenderTransformOrigin="50%,50%">
                <Panel.RenderTransform><RotateTransform Angle="0" /></Panel.RenderTransform>
                <Ellipse Width="196" Height="76" Stroke="{DynamicResource HorusAccentInkBrush}" StrokeThickness="1" RenderTransform="rotate(35deg)" />
                <Ellipse Width="196" Height="76" Stroke="{DynamicResource HorusAccentInkBrush}" StrokeThickness="1" RenderTransform="rotate(-35deg)" />
                <Ellipse Width="8" Height="8" Fill="{DynamicResource HorusAccentInkBrush}" Margin="0,14,0,0" VerticalAlignment="Top" />
              </Panel>
              <Path Data="M 60,110 Q 110,65 160,110 Q 110,155 60,110 M 110,94 A 16,16 0 1 1 109.9,94 M 110,126 L 97,154 L 119,143"
                    Stroke="{DynamicResource HorusInkBrush}" StrokeThickness="2" />
            </Panel>
          </Viewbox>
        </Grid>
      </Border>

      <WrapPanel Orientation="Horizontal">
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,20,12">
          <RadioButton Classes="segment" GroupName="HomeFilter" Content="TODOS 6" IsChecked="True" />
          <RadioButton Classes="segment" GroupName="HomeFilter" Content="PENDENTES 2" />
          <RadioButton Classes="segment" GroupName="HomeFilter" Content="CONCLUÍDOS 2" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
          <TextBox Width="200" PlaceholderText="Buscar" />
          <Button Classes="primary" Content="NOVO ITEM" />
        </StackPanel>
      </WrapPanel>

      <TextBlock Classes="label" Text="01 / SEÇÃO DE EXEMPLO" />

      <Border HorizontalAlignment="Left"
              BorderBrush="{DynamicResource HorusLineBrush}"
              BorderThickness="1,1,0,0">
      <ItemsControl ItemsSource="{Binding ExampleCards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel ItemWidth="350" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ExampleCard">
            <Border Classes="studyCard" BorderBrush="{DynamicResource HorusLineBrush}"
                    BorderThickness="0,0,1,1">
              <DockPanel>
                <Border DockPanel.Dock="Top"
                        Padding="16,8"
                        BorderBrush="{DynamicResource HorusLineBrush}"
                        BorderThickness="0,0,0,1">
                  <Border Background="{DynamicResource HorusInvertBackgroundBrush}"
                          HorizontalAlignment="Left"
                          Padding="7,2">
                    <TextBlock FontFamily="{StaticResource HorusMonoFont}" FontSize="11"
                               Foreground="{DynamicResource HorusInvertForegroundBrush}"
                               Text="{Binding Number}" />
                  </Border>
                </Border>
                <StackPanel Margin="16" Spacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="display" FontSize="18" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted"
                               Height="38"
                               Text="{Binding Description}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Classes="tag" HorizontalAlignment="Left">
                    <TextBlock Classes="label" Text="{Binding Status}" />
                  </Border>
                  <TextBlock Classes="muted" Text="{Binding Meta}" />
                  <Grid ColumnDefinitions="*,8,Auto">
                    <Button Classes="primary"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Content="{Binding Action}" />
                    <Button Grid.Column="2"
                            Width="40"
                            Padding="0,9"
                            HorizontalContentAlignment="Center"
                            Content="···" />
                  </Grid>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
