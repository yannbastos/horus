<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Horus.Views.OverviewView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,28" Spacing="26">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="7">
          <TextBlock Classes="label" Text="01 / VISÃO GERAL" Foreground="{DynamicResource HorusAccentInkBrush}" />
          <TextBlock Classes="display" FontSize="26" Text="Um novo olhar para criar." />
        </StackPanel>
        <Border Grid.Column="1" Classes="tag" VerticalAlignment="Center">
          <TextBlock Classes="label" FontSize="9" Text="PRÉVIA DE LAYOUT" />
        </Border>
      </Grid>
      <Border Background="{DynamicResource HorusSunkenBrush}" BorderBrush="{DynamicResource HorusLineBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid ColumnDefinitions="*,220" MinHeight="260">
          <StackPanel Margin="28" VerticalAlignment="Center" Spacing="16">
            <TextBlock Classes="label" FontSize="10" Text="PESQUISE. CONECTE. TRANSFORME." Foreground="{DynamicResource HorusAccentInkBrush}" />
            <TextBlock Classes="display" FontSize="32" Text="Da referência&#10;à sua próxima história." TextWrapping="Wrap" />
            <TextBlock Classes="muted" FontSize="14" MaxWidth="470" HorizontalAlignment="Left" TextWrapping="Wrap"
                       Text="Um espaço para estudar conteúdos, descobrir caminhos e dar forma às suas ideias." />
            <WrapPanel>
              <Button x:Name="OpenTranscriptionButton" Classes="primary" Content="ABRIR TRANSCRIÇÃO" Click="RequestTranscription" Margin="0,0,10,6" />
              <Button x:Name="OpenRadarButton" Content="EXPLORAR RADAR" Click="RequestRadar" Margin="0,0,0,6" />
            </WrapPanel>
          </StackPanel>
          <Viewbox Grid.Column="1" Margin="0,24,20,24" IsHitTestVisible="False">
            <Panel Width="220" Height="220">
              <Ellipse Width="184" Height="184" Stroke="{DynamicResource HorusLineStrongBrush}" StrokeThickness="1" />
              <Ellipse Width="140" Height="140" Stroke="{DynamicResource HorusLineBrush}" StrokeThickness="1" />
              <Ellipse Width="196" Height="76" Stroke="{DynamicResource HorusAccentInkBrush}" StrokeThickness="1" RenderTransform="rotate(35deg)" />
              <Ellipse Width="196" Height="76" Stroke="{DynamicResource HorusAccentInkBrush}" StrokeThickness="1" RenderTransform="rotate(-35deg)" />
              <Ellipse Width="8" Height="8" Fill="{DynamicResource HorusAccentInkBrush}" Margin="0,14,0,0" VerticalAlignment="Top" />
              <Path Data="M 60,110 Q 110,65 160,110 Q 110,155 60,110 M 110,94 A 16,16 0 1 1 109.9,94 M 110,126 L 97,154 L 119,143"
                    Stroke="{DynamicResource HorusInkBrush}" StrokeThickness="2" />
            </Panel>
          </Viewbox>
        </Grid>
      </Border>
      <StackPanel Spacing="14">
        <TextBlock Classes="label" Text="UM FLUXO, DO PRIMEIRO SINAL À ENTREGA" />
        <UniformGrid Columns="3">
          <Border Classes="workspaceCard" Margin="0,0,10,0">
            <StackPanel Spacing="12">
              <TextBlock Classes="label" Text="01 / DESCOBRIR" Foreground="{DynamicResource HorusAccentInkBrush}" />
              <TextBlock Classes="display" FontSize="17" Text="Encontre um caminho." TextWrapping="Wrap" />
              <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Text="Referências, formatos e ideias que merecem um olhar mais atento." />
              <TextBlock Classes="label" FontSize="9" Text="RADAR · EM PREPARAÇÃO" />
            </StackPanel>
          </Border>
          <Border Classes="workspaceCard" Margin="0,0,10,0">
            <StackPanel Spacing="12">
              <TextBlock Classes="label" Text="02 / COMPREENDER" Foreground="{DynamicResource HorusAccentInkBrush}" />
              <TextBlock Classes="display" FontSize="17" Text="Transforme em repertório." TextWrapping="Wrap" />
              <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Text="Transcreva seus materiais e encontre novas conexões no conteúdo." />
              <TextBlock Classes="label" FontSize="9" Text="TRANSCRIÇÃO · DISPONÍVEL" Foreground="{DynamicResource HorusGoodBrush}" />
            </StackPanel>
          </Border>
          <Border Classes="workspaceCard">
            <StackPanel Spacing="12">
              <TextBlock Classes="label" Text="03 / CRIAR" Foreground="{DynamicResource HorusAccentInkBrush}" />
              <TextBlock Classes="display" FontSize="17" Text="Dê forma à história." TextWrapping="Wrap" />
              <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Text="Do briefing à revisão final, com espaço para suas escolhas." />
              <TextBlock Classes="label" FontSize="9" Text="PRODUÇÃO · EM PREPARAÇÃO" />
            </StackPanel>
          </Border>
        </UniformGrid>
      </StackPanel>
      <Grid ColumnDefinitions="3*,20,2*">
        <Border Classes="workspaceCard">
          <StackPanel Spacing="14">
            <TextBlock Classes="label" Text="SEU PRÓXIMO PASSO" />
            <TextBlock Classes="display" FontSize="21" Text="Comece pelo conteúdo." />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Abra um áudio ou vídeo na transcrição. Você pode revisar, editar e salvar o texto antes de seguir para o próximo arquivo." />
            <TextBlock Classes="label" FontSize="9" Text="ARQUIVOS LOCAIS · TEXTO SOB SEU CONTROLE" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="workspaceCard" Background="{DynamicResource HorusSunkenBrush}">
          <StackPanel Spacing="14">
            <TextBlock Classes="label" Text="CONSTRUINDO O HORUS" />
            <TextBlock Classes="display" FontSize="21" Text="Um passo de cada vez." TextWrapping="Wrap" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Explore a organização da plataforma. Pesquisa, canais e produção ainda são prévias e não executam operações." />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
