<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Horus.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Horus/Theme/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#2D81FF" />
        <ColorPaletteResources x:Key="Dark" Accent="#2D81FF" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Horus/Theme/Styles.axaml" />
  </Application.Styles>
</Application>
