<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource HorusBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HorusInkBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource HorusBodyFont}" />
  </Style>

  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{StaticResource HorusDisplayFont}" />
    <Setter Property="Foreground" Value="{DynamicResource HorusInkStrongBrush}" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontFamily" Value="{StaticResource HorusMonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Foreground" Value="{DynamicResource HorusMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource HorusMutedBrush}" />
  </Style>

  <Style Selector="Border.row:pointerover">
    <Setter Property="Background" Value="{DynamicResource HorusSunkenBrush}" />
  </Style>

  <Style Selector="RadioButton.segment">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource HorusMonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Foreground" Value="{DynamicResource HorusMutedBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            Padding="{TemplateBinding Padding}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource HorusLineBrush}" />
  </Style>
  <Style Selector="RadioButton.segment:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource HorusInkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HorusLineStrongBrush}" />
  </Style>
  <Style Selector="RadioButton.segment:checked">
    <Setter Property="Background" Value="{DynamicResource HorusInvertBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HorusInvertForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HorusInvertBackgroundBrush}" />
  </Style>

  <Style Selector="Border.tag">
    <Setter Property="Background" Value="{DynamicResource HorusSunkenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HorusLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,3" />
  </Style>

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="20,9" />
    <Setter Property="FontFamily" Value="{StaticResource HorusMonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource HorusInkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HorusLineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HorusSunkenBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HorusInkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HorusInkBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HorusSunkenBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HorusInkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HorusLineStrongBrush}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource HorusInvertBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HorusInvertForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HorusInvertBackgroundBrush}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HorusInvertBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HorusInvertForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HorusInkBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HorusInvertBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HorusInvertForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HorusMutedBrush}" />
  </Style>

  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource HorusFaintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HorusLineBrush}" />
  </Style>


  <!-- Movimento finito: a ilustração repousa depois da entrada. -->
  <Style Selector="Panel.orbit">
    <Style.Animations>
      <Animation Duration="0:0:2.4" FillMode="Forward">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="-35" /><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="0" /><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.studyCard">
    <Setter Property="Background" Value="{DynamicResource HorusBackgroundBrush}" />
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Background" Duration="0:0:0.18" /><BrushTransition Property="BorderBrush" Duration="0:0:0.18" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.studyCard:pointerover">
    <Setter Property="Background" Value="{DynamicResource HorusSunkenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HorusAccentInkBrush}" />
  </Style>
  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Background" Duration="0:0:0.14" /><BrushTransition Property="BorderBrush" Duration="0:0:0.14" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="RadioButton.segment:checked">
    <Setter Property="Background" Value="{DynamicResource HorusSunkenBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HorusAccentInkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HorusAccentInkBrush}" />
  </Style>

  <!-- Campos de texto -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource HorusBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HorusInkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HorusLineStrongBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource HorusInkBrush}" />
  </Style>
  <Style Selector="TextBox:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource HorusInkBrush}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource HorusBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HorusInkBrush}" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="Foreground" Value="{DynamicResource HorusInkBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource HorusBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HorusAccentInkBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Área de leitura e edição da transcrição -->
  <Style Selector="TextBox.transcript">
    <Setter Property="Padding" Value="24,20" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="27" />
    <Setter Property="BorderBrush" Value="{DynamicResource HorusLineBrush}" />
  </Style>
  <Style Selector="TextBox.transcript:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource HorusLineStrongBrush}" />
  </Style>

  <!-- Área para soltar arquivos -->
  <Style Selector="Border.dropZone">
    <Setter Property="Background" Value="{DynamicResource HorusBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HorusLineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.18" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.dropZone:pointerover, Border.dropZone.dragging">
    <Setter Property="BorderBrush" Value="{DynamicResource HorusAccentInkBrush}" />
  </Style>

  <!-- Etapas: transcrever, salvar e avançar -->
  <Style Selector="Border.step">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource HorusLineBrush}" />
  </Style>
  <Style Selector="Border.step.done">
    <Setter Property="Background" Value="{DynamicResource HorusInvertBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HorusInvertBackgroundBrush}" />
  </Style>
  <Style Selector="Border.step.done TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource HorusInvertForegroundBrush}" />
  </Style>
  <Style Selector="Border.step.ready">
    <Setter Property="BorderBrush" Value="{DynamicResource HorusAccentInkBrush}" />
  </Style>
  <Style Selector="Border.step.ready TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource HorusAccentInkBrush}" />
  </Style>

  <Style Selector="ProgressBar.horus">
    <Setter Property="MinHeight" Value="3" />
    <Setter Property="Height" Value="3" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource HorusAccentInkBrush}" />
    <Setter Property="Background" Value="{DynamicResource HorusLineBrush}" />
  </Style>

</Styles>
